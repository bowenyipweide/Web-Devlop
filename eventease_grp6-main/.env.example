# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Node Environment
NODE_ENV=production

# MongoDB Configuration
MONGODB_URI=mongodb+srv://eventease_admin:PASSWORD@cluster.mongodb.net/eventease?retryWrites=true&w=majority
MONGODB_DATABASE=eventease

# Frontend Configuration
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-secret-key-here

# Server Port
PORT=5000

# Optional: Stripe Configuration
# STRIPE_SECRET_KEY is what the server uses. STRIPE_WEBHOOK_SECRET is what makes
# paid bookings confirm even when the buyer's browser never makes it back to the
# success page — get it with:
#   stripe listen --forward-to localhost:5000/api/payments/webhook
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Email Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Grafana Cloud Profiles (use the values shown under Pyroscope > Send Profiles)
PYROSCOPE_SERVER_ADDRESS=
PYROSCOPE_BASIC_AUTH_USER=
PYROSCOPE_BASIC_AUTH_PASSWORD=
